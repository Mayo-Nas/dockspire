# Only source and license notices needed by the Dockerfile enter the build.
**
!Dockerfile
!LICENSE
!NOTICE
!go.mod
!go.sum
!cmd/**/*.go
!internal/**/*.go
!web/*.go
!web/*.html
!web/*.css
!web/*.js
!web/brand/dockspire-icon-256.png
!web/brand/dockspire-horizontal-dark.png
!licenses/*.txt
!licenses/*-LICENSE
!licenses/*-NOTICE
!deploy/compose-runtime/go.mod
!deploy/compose-runtime/go.sum
# Private files stay excluded even beneath a source directory.
**/*_test.go
**/tests/**
**/testdata/**
**/.git
**/.git/**
**/.vscode
**/.vscode/**
**/.idea
**/.idea/**
**/*.code-workspace
**/.env*
**/*.pem
**/*.key
**/.local/**
**/.codex/**
**/.agents/**
**/AGENTS.md
**/CLAUDE.md
**/GEMINI.md
**/*.pfx
**/*.p12
**/admin.json
**/secrets/**
**/data/**
**/backups/**
**/.ssh/**
**/.aws/**
**/*.exe
**/*.test
**/*.log
**/node_modules/**
**/.cache/**
**/bin/**
**/dist/**
**/host-refresh-diagnostic.*
